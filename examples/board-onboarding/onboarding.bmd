board "Lulu Board"
style eyJ0aGVtZSI6ImNsYXNzaWMiLCJ2aWV3cG9ydCI6eyJzY2FsZSI6MC45NzUxMTQ4Njk1NTA4MjMyLCJjeCI6NTAyLCJjeSI6MjkzfX0=
box HERO type layout
  item type icon 515
  box COPY type layout
    item type text cap off "# Welcome to Lulu Board\n## One protocol. AI writes it. Lulu Board draws it. You work on the canvas."
box AI type container 206 "AI"
  item cap off "/board login flow"
box CANVAS type container 307 "Lulu Board"
  box MINI type layout
    box LOGIN 512 "Login"
      item "Email · Password"
    box HOME 205 "Home"
      item "Welcome"
box YOU type container 201 "You"
  item cap off "drag · edit · link"
box PROTO type container "A compact protocol"
  box PROTOROW type layout
    item type note "`box LOGIN 512 \"Login\"`\n`  item \"Email · Password\"`\n`box HOME 205 \"Home\"`\n`  item \"Welcome\"`\n`LOGIN -> HOME title \"success\"`"
    box WORDS type layout
      item type text cap off "`box`  card"
      item type text cap off "`item`  leaf"
      item type text cap off "`->`  link"
LOGIN -> HOME title "success"
AI <-> PROTO title "writes"
CANVAS <-> YOU title "on canvas"
CANVAS <-> PROTO title "in sync"
layout
  direction HERO, MINI, PROTOROW row
  align COPY, WORDS start
  align HERO, PROTOROW, AI, YOU, PROTO, CANVAS center
  align MINI stretch
  justify WORDS, AI, YOU center
  justify MINI stretch
  arrange AI below HERO
  arrange CANVAS after AI
  arrange YOU after CANVAS
  flush AI, CANVAS, YOU top
  flush AI, CANVAS, YOU bottom
  flush HERO, AI start
  pin HERO.start to parent.start 40
  pin HERO.top to parent.top 36
  pin CANVAS.start to AI.end 56
  pin YOU.start to CANVAS.end 56
  pin PROTO.start to parent.start 273
  pin PROTO.end to CANVAS.end
  pin PROTO.top to parent.top 393
