board "LLM Technical Architecture"
style eyJsaW5rX3JvdXRlIjoic3RhZ2dlciJ9
box APP "Application Layer"
  item type text "User"
  item "Chat / Copilot / API"
  item "Agent"
box ORCH "Orchestration Layer"
  item type text "Retriever"
  item "Prompt Assembly"
  item "RAG / Memory"
  item "Tools / Function"
box SERV "Inference Service"
  item type text "Engine"
  item "Tokenizer"
  item "Continuous Batching"
  item "KV Cache"
  item "Sampling"
box MODEL "Model Layer"
  item type text "Core"
  item "Embedding"
  item "Self-Attention"
  item "FFN / MoE"
  item "LM Head"
box TRAIN "Training Layer"
  item type text "Pipeline"
  item "Corpus & Cleaning"
  item "Pretrain"
  item "SFT"
  item "RLHF / DPO"
box HW "Infrastructure"
  item type text "Store"
  item "GPU / NPU"
  item "DP / TP / PP / ZeRO"
  item "Checkpoint"
item READ type note "# How to read\n- Downward is **use**: a request becomes tokens\n- Upward is **make**: weights are trained\n- Everything lands on GPU parallelism"
APP -> ORCH title "Request"
ORCH -> SERV title "Completion"
SERV -> MODEL title "forward"
TRAIN -> MODEL title "Weights"
MODEL -> HW title "Compute"
SERV -> HW type dashed title "Schedule"
TRAIN -> HW type dashed title "Cluster"
layout
  direction row
  direction APP, ORCH, SERV, MODEL, TRAIN, HW column
  pin TRAIN.start to parent.start 1010
  pin TRAIN.top to parent.top 24
  pin HW.start to parent.start 17
  pin HW.top to parent.top 316
  pin READ.start to parent.start 438
  pin READ.top to parent.top 524
  pin MODEL.start to parent.start 781
  pin MODEL.top to parent.top 24
  pin SERV.start to parent.start 517
  pin SERV.top to parent.top 26
  pin ORCH.start to parent.start 271
  pin ORCH.top to parent.top 27
  pin APP.start to parent.start 15
  pin APP.top to parent.top 25
