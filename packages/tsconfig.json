{
  "compilerOptions": {
    "target": "ES2018",
    "lib": ["DOM", "ES2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,
    "allowJs": true,
    "declaration": true,
    "noEmitOnError": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "exclude": ["**/node_modules/*", "**/dist/*", ".git", "coverage", "assets", "scripts"]
}
