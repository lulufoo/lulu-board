# Boxes template. icon <n> and box-face <n> come from icons.json.

boxes "Boxes"

box CARD 002 "Card"
  item type text "Text"
  item "Chip"
  item type note "# Note\nThis is the Boxes template.\n- Each label names its piece.\n- Replace the labels with your own."
  item MARK type icon 008 "Icon"

item GATE shape diamond "Diamond"

box GROUP type container "Container"
  box INNER "Card"
    item "Chip"
  box ROW type layout
    item "Chip"

box NEXT "Card"
  item "Chip"

CARD -> GATE title "solid"
GATE -> INNER title "solid"
CARD <-> NEXT title "both"
GATE -> NEXT type dashed title "dashed"

layout
  direction ROW, GROUP row
  align_x CARD, INNER left
  align_y GROUP center
  align_x NEXT stretch
  pin CARD.start to parent.start -31
  pin CARD.top to parent.top 172
  pin GATE.start to parent.start 352
  pin GATE.top to parent.top 284
  pin GROUP.start to parent.start 557
  pin GROUP.top to parent.top 205
  pin NEXT.start to parent.start 352
  pin NEXT.top to parent.top 503
